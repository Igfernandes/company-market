#!/usr/bin/env php
<?php

use CodeIgniter\Boot;
use Config\Paths;

if (isset($argv[1]) && $argv[1] === 'test') {
    putenv('CI_ENVIRONMENT=testing');
    $_ENV['CI_ENVIRONMENT']   = 'testing';
    $_SERVER['CI_ENVIRONMENT'] = 'testing';
}

if (str_starts_with(PHP_SAPI, 'cgi')) {
    exit("The cli tool is not supported when running php-cgi. It needs php-cli to function!\n\n");
}

$minPhpVersion = '8.1';
if (version_compare(PHP_VERSION, $minPhpVersion, '<')) {
    exit(sprintf('Your PHP version must be %s or higher. Current: %s', $minPhpVersion, PHP_VERSION));
}

error_reporting(E_ALL);
ini_set('display_errors', '1');

define('FCPATH', __DIR__ . DIRECTORY_SEPARATOR . 'public' . DIRECTORY_SEPARATOR);

// Não chdir para evitar problemas de caminhos relativos
// chdir(FCPATH);

require __DIR__ . '/app/Config/Paths.php';

$paths = new Paths();

// Define SUPPORTPATH antes de carregar o bootstrap
defined('SUPPORTPATH') || define('SUPPORTPATH', realpath($paths->supportDirectory) . DIRECTORY_SEPARATOR);

require rtrim($paths->systemDirectory, '\\/') . '/Boot.php';

exit(Boot::bootSpark($paths));
