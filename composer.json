{
  "name": "codeigniter4/appstarter",
  "type": "project",
  "description": "CodeIgniter4 starter app",
  "homepage": "https://codeigniter.com",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "agungsugiarto/codeigniter4-cors": "^2.0",
    "cboden/ratchet": "^0.4.4",
    "clue/redis-react": "^2.8",
    "codeigniter4/framework": "4.6",
    "dompdf/dompdf": "^2.0",
    "mercadopago/dx-php": "^2.6",
    "minishlink/web-push": "^9.0",
    "pagseguro/pagseguro-php-sdk": "^4.2",
    "phpoffice/phpspreadsheet": "^4.4",
    "predis/predis": "^3.0",
    "react/event-loop": "^1.5",
    "react/socket": "^1.16"
  },
  "require-dev": {
    "fakerphp/faker": "^1.9",
    "mikey179/vfsstream": "^1.6",
    "phpunit/phpunit": "^10.5.16"
  },
  "suggest": {
    "ext-fileinfo": "Improves mime type detection for files"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/",
      "PHPMailer\\PHPMailer\\": "app/ThirdParty/Mailer/src/",
      "MercadoPago\\": "vendor/mercadopago/dx-php/src/MercadoPago/",
      "PagSeguro\\": "vendor/pagseguro/pagseguro-php-sdk/source/"
    },
    "exclude-from-classmap": [
      "**/Database/Migrations/**",
      "vendor/mercadopago/dx-php/tests/",
      "vendor/pagseguro/pagseguro-php-sdk/source/Configuration/Wrapper-example.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Support\\": "tests/_support"
    }
  },
  "scripts": {
    "test": "phpunit --no-coverage"
  },
  "support": {
    "forum": "http://forum.codeigniter.com/",
    "source": "https://github.com/codeigniter4/CodeIgniter4",
    "slack": "https://codeigniterchat.slack.com"
  }
}
